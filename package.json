{
  "name": "hermes-asia-x402-mcp-server",
  "version": "1.0.1",
  "description": "MCP server exposing Hermes Asia x402 products with built-in USDC payment handling",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hermes-asia-x402": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "x402",
    "ai-agents",
    "cryptocurrency",
    "usdc",
    "base",
    "hermes"
  ],
  "author": "Keiten <keitenisthefuture2029@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.0",
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "mcpName": "io.github.kten-agent/x402-mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kten-agent/x402-mcp-server.git"
  },
  "homepage": "https://github.com/kten-agent/x402-mcp-server"
}