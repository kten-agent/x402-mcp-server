# Hermes Asia x402 MCP Server - Environment Variables

# REQUIRED: Your Base mainnet wallet private key (for signing x402 payments)
# Format: hex string with or without 0x prefix
# Example: 0x1234abcd... or 1234abcd...
X402_WALLET_PRIVATE_KEY=

# REQUIRED: The Hermes x402 Worker URL
# Default: https://base-worker-01.j23726919.workers.dev
WORKER_URL=https://base-worker-01.j23726919.workers.dev

# OPTIONAL: Override the default RPC URL for balance checks
# BASE_RPC_URL=https://mainnet.base.org

